{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "text": { "primary": { "$value": "#1F1F1F", "$type": "color" }, "muted": { "$value": "#444746", "$type": "color" } },
    "action": { "primary": { "$value": "#0B57D0", "$type": "color" }, "selected": { "$value": "#D3E3FD", "$type": "color" } },
    "surface": { "page": { "$value": "#F8FAFD", "$type": "color" }, "card": { "$value": "#FFFFFF", "$type": "color" }, "border": { "$value": "#E0E3E7", "$type": "color" } },
    "accent": { "blue": { "$value": "#2785FA", "$type": "color" }, "green": { "$value": "#15B851", "$type": "color" }, "yellow": { "$value": "#FFCD13", "$type": "color" }, "red": { "$value": "#FF3835", "$type": "color" } },
    "brand": { "subtitle": { "$value": "#249CE8", "$type": "color" }, "darkText": { "$value": "#14171A", "$type": "color" }, "darkBackground": { "$value": "#111315", "$type": "color" } }
  },
  "space": { "1": { "$value": "4px", "$type": "dimension" }, "2": { "$value": "8px", "$type": "dimension" }, "3": { "$value": "12px", "$type": "dimension" }, "4": { "$value": "16px", "$type": "dimension" }, "5": { "$value": "20px", "$type": "dimension" }, "6": { "$value": "24px", "$type": "dimension" }, "8": { "$value": "32px", "$type": "dimension" } },
  "radius": { "control": { "$value": "24px", "$type": "dimension" }, "card": { "$value": "20px", "$type": "dimension" }, "hero": { "$value": "24px", "$type": "dimension" } },
  "typography": { "fontFamily": { "$value": "Google Sans, Roboto, Arial, sans-serif", "$type": "fontFamily" } },
  "material": {
    "primary": { "$value": "{color.action.primary}", "$type": "color", "$description": "--md-sys-color-primary" },
    "onPrimary": { "$value": "#FFFFFF", "$type": "color", "$description": "--md-sys-color-on-primary" },
    "onSurface": { "$value": "{color.text.primary}", "$type": "color", "$description": "--md-sys-color-on-surface" },
    "onSurfaceVariant": { "$value": "{color.text.muted}", "$type": "color", "$description": "--md-sys-color-on-surface-variant" },
    "outline": { "$value": "#747775", "$type": "color", "$description": "--md-sys-color-outline" },
    "outlineVariant": { "$value": "{color.surface.border}", "$type": "color", "$description": "--md-sys-color-outline-variant" }
  }
}
